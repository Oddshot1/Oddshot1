# ODDSHOT Environment Variables Template
# Copy this to .env.local and fill in your actual values
# NEVER commit .env or .env.local to git!

# ======================
# Frontend Configuration
# ======================

# Supabase Configuration (Public - Safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here

# ======================
# Supabase Edge Function Secrets
# ======================
# ⚠️ IMPORTANT: Set these in Supabase Dashboard → Project Settings → Secrets
# DO NOT put these in .env file on production

# AI Provider Configuration (choose one)
AI_PROVIDER=openai                    # Options: openai, groq, anthropic, custom
AI_API_KEY=sk_your_actual_api_key     # Keep secret!
AI_MODEL=gpt-3.5-turbo               # Choose your model
# AI_API_ENDPOINT=https://...        # Optional: for custom AI endpoints

# Sports Odds API
ODDS_API_KEY=your_odds_api_key        # From theoddsapi.com

# ======================
# Development Settings
# ======================

# Development mode
VITE_ENV=development
DEBUG=true

# ======================
# Security Notes
# ======================
# 1. Never commit this file with real values
# 2. Use .env.local for local development
# 3. Set secrets in Supabase Dashboard for production
# 4. Rotate API keys every 90 days
# 5. Use separate keys for dev/staging/production

# ======================
# Deployment Checklist
# ======================
# ✅ Frontend: VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY
# ✅ Supabase Secrets:
#    - AI_PROVIDER, AI_API_KEY, AI_MODEL
#    - ODDS_API_KEY
# ✅ CORS Origins updated in Edge Functions
# ✅ JWT verification enabled in config.toml
# ✅ Rate limiting tested
